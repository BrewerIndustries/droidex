{
  "name": "Droidex Android Offline",
  "short_name": "Droidex",
  "description": "Offline-first Droid tracker",
  "start_url": "./#/",
  "scope": "./",
  "display": "standalone",
  "background_color": "#000000",
  "theme_color": "#000000",
  "orientation": "portrait",
  "categories": ["games", "productivity"],
  "id": "./",
  "lang": "en",
  "screenshots": [
    {
      "src": "./screenshot1.png",
      "sizes": "1080x2400",
      "type": "image/png"
    }
  ],

  "display_override": ["window-controls-overlay", "standalone"],

  "icons": [
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ]
}
